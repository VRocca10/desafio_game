{
  "name": "pirate-battle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode test --outDir dist-test",
    "profile": "npm run build:test && node scripts/profile.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:e2e": "npm run build:test && playwright test",
    "test:e2e:ui": "npm run build:test && playwright test --ui",
    "test:report": "playwright show-report",
    "mocks:init": "msw init public --save"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "msw": "^3.0.1",
    "pixi.js": "^8.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
